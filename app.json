{
  "expo": {
    "name": "ShabzOS",
    "slug": "shabzos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shabzos",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f2ff"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.shabzos.launcher",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#f7f2ff"
      },
      "intentFilters": [
        {
          "action": "MAIN",
          "category": ["HOME", "DEFAULT", "LAUNCHER"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
